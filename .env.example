# =============================================================================
# Edunews24 AI Visibility Monitor — configurazione
# =============================================================================
# Copia questo file in `.env` e riempi i valori. Nessun valore qui dentro e'
# un default utilizzabile: dove serve una credenziale, serve la tua.
#
# ATTENZIONE — QUALUNQUE VALORE CHE CONTIENE `$` VA FRA APICI SINGOLI.
# Docker Compose interpola i `$` nei valori di questo file: `pa$$word`
# diventerebbe `paword`, e un hash argon2 (`$argon2id$v=19$...`) verrebbe
# ridotto a spazzatura con un login che non funziona e nessun errore che dica
# perche'. Fra apici singoli il valore arriva intatto:
#
#     ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$...'
#     SOURCE_DB_URL='postgresql+asyncpg://utente:pa$$word@host:5432/postgres'
#
# Vale per hash, password e connection string. Se generi le password con
# `openssl rand -base64 32` il problema non si presenta (base64 non contiene
# `$`), ma gli apici non fanno danno: l'applicazione li rimuove comunque.
# =============================================================================


# --- Ambiente ----------------------------------------------------------------
ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json
# Tutta la schedulazione e ogni aggregato giornaliero usano questo fuso:
# "oggi" per un giornale italiano significa oggi a Roma, non a UTC.
TZ=Europe/Rome


# --- DB SORGENTE (SOLA LETTURA) ----------------------------------------------
# Ruolo con il solo privilegio SELECT su SOURCE_TABLE. Crealo con
# `sql/readonly_role.sql`. Se questa connessione puo' scrivere, l'applicazione
# si rifiuta di partire: non e' una precauzione opzionale.
#
# Usa il pooler Supavisor in SESSION mode (porta 5432 su ...pooler.supabase.com):
# il collegamento diretto db.<ref>.supabase.co e' IPv6-only sui progetti recenti
# e da un VPS senza IPv6 non si connette. Nota il suffisso .<PROJECT_REF> nello
# username, richiesto dal pooler.
SOURCE_DB_URL=postgresql+asyncpg://edunews_monitor_ro.PROJECT_REF:PASSWORD@aws-0-REGIONE.pooler.supabase.com:5432/postgres
SOURCE_SCHEMA=public
SOURCE_TABLE=articles


# --- DB MONITORAGGIO (lettura/scrittura, progetto SEPARATO) ------------------
# Secondo progetto Supabase. Non deve mai coincidere con il precedente.
MONITOR_DB_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGIONE.pooler.supabase.com:5432/postgres
MONITOR_POOL_SIZE=5
MONITOR_MAX_OVERFLOW=5
# Lascia `true` con qualunque pooler: senza, asyncpg fallisce con
# "prepared statement already exists" appena il pooler riusa una connessione.
DB_DISABLE_PREPARED_STATEMENTS=true


# --- Provider LLM ------------------------------------------------------------
# Chiave assente = adapter disattivato con un log informativo, non un errore.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ATTENZIONE — Gemini non parte solo perche' hai messo la chiave.
# I termini dell'API Gemini vietano esplicitamente cio' che questo servizio fa
# con i risultati di grounding:
#   "You will not [...] cache, frame, syndicate, resell, analyze, train on, or
#    otherwise learn from Grounded Results or Search Suggestions"
#   "using programmatic or automated means to collect Links, using Links to
#    build an index"
#   "You will only display the Grounded Results [...] to the end user who
#    submitted the prompt"
# Un monitor di visibilita' fa tutte e tre le cose. Metti `true` solo dopo un
# parere legale o un permesso scritto da Google. Vedi docs/providers.md.
GEMINI_ENABLED=false

# I model ID stanno in configurazione perche' i provider li deprecano piu' in
# fretta di quanto si rifattorizzi un adapter. Verificati il 2026-07-30, vedi
# docs/providers.md. Nota: in una serie storica di mesi conviene fissare uno
# snapshot datato, perche' gli alias vengono ripuntati e un cambio di modello
# somiglierebbe a un cambio di visibilita' del giornale.
OPENAI_MODEL=gpt-5.6-luna
PERPLEXITY_MODEL=sonar
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.5-flash

# Endpoint OpenAI, configurabile per puntare a un proxy compatibile.
OPENAI_BASE_URL=https://api.openai.com/v1

# Dimensione del contesto di ricerca. Su OpenAI incide sui token recuperati,
# che paghi come input; su Perplexity e' anche la fascia di prezzo per
# richiesta, dove `low` e' il default economico.
OPENAI_SEARCH_CONTEXT_SIZE=medium
PERPLEXITY_SEARCH_CONTEXT_SIZE=low

# Versione base del tool di web search di Anthropic: le versioni con dynamic
# filtering annidano i blocchi della risposta e complicano l'estrazione.
ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305
# Tetto di ricerche per richiesta: e' l'unico freno di spesa vero, perche' ogni
# ricerca e' fatturata a parte.
ANTHROPIC_MAX_USES=5
ANTHROPIC_MAX_TOKENS=4096

# Localizzazione dichiarata delle richieste. Senza, i risultati pendono verso
# la geografia di default del provider e le domande italiane fanno emergere
# meno domini italiani: sarebbe un bias sistematico contro il giornale.
PROBE_COUNTRY=IT
PROBE_CITY=Roma
PROBE_REGION=Lazio


# --- Comportamento del monitor -----------------------------------------------
# Query DISTINTE al giorno. I probe effettivi sono questo numero x n_provider.
DAILY_QUERY_BUDGET=200
MAX_CONCURRENCY_PER_PROVIDER=3
PROBE_TIMEOUT_SECONDS=120
OWN_DOMAIN=edunews24.it

# Quota di probe eseguiti senza strumenti, per misurare se il brand e' nella
# conoscenza parametrica del modello. E' una metrica DIVERSA dalla citazione e
# non viene mai mescolata con essa.
MEMORY_MODE_SAMPLE_RATE=0.1


# --- Generatore di query -----------------------------------------------------
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_PROVIDER=openai
QUERY_REWRITE_MODEL=gpt-5-mini

# Composizione del lotto orario. Devono sommare a 100.
BUCKET_FRESH_PCT=50      # pubblicati nelle ultime 72h
BUCKET_RECENT_PCT=20     # tra 3 e 30 giorni
BUCKET_ARCHIVE_PCT=20    # rotazione archivio, last_probed_at NULLS FIRST
BUCKET_CATEGORY_PCT=10   # domande di categoria, non legate a un articolo

QUERY_DEDUP_WINDOW_DAYS=14


# --- Budget (kill switch) ----------------------------------------------------
# Superata la soglia lo scheduler salta i cicli e scrive un run
# `skipped_budget`. Nessuna spesa a sorpresa.
MAX_DAILY_SPEND_EUR=5
MAX_MONTHLY_SPEND_EUR=100

# I listini dei provider sono in USD, il DB e la dashboard in EUR. Nessuna
# chiamata a un servizio di cambio a runtime: aggiorna questo valore quando
# aggiorni pricing.yaml.
USD_EUR_RATE=0.92
PRICING_FILE=pricing.yaml
PRICING_MAX_AGE_DAYS=90


# --- Retention ---------------------------------------------------------------
# `raw_response` serve a verificare il parser, non a essere conservato per
# sempre. Gli aggregati in daily_rollup restano comunque.
RAW_RETENTION_DAYS=30
ANSWER_RETENTION_DAYS=180


# --- Auth (un solo amministratore) -------------------------------------------
# Genera l'hash con:
#   docker compose run --rm app python -c \
#     "from argon2 import PasswordHasher; print(PasswordHasher().hash(input()))"
#
# L'hash CONTIENE `$`: va fra apici singoli, altrimenti Compose lo distrugge.
ADMIN_PASSWORD_HASH=''
# Almeno 32 caratteri:  openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=604800
# `false` solo se servi in HTTP puro su localhost, mai in produzione.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax


# --- Rete --------------------------------------------------------------------
# QUESTA e' la porta che ti interessa: quella su cui il servizio risponde SULLA
# MACCHINA. Cambiala qui e basta, non serve toccare nient'altro.
APP_PORT=8000

# Indirizzo su cui la porta viene aperta. `127.0.0.1` la rende raggiungibile
# SOLO da questa macchina, che e' la scelta giusta: davanti ci va un reverse
# proxy che termina TLS.
#
# Metti `0.0.0.0` solo se sai perche' lo stai facendo. Il cookie di sessione e'
# `Secure` e il browser non lo invia su HTTP: esponendo questa porta
# direttamente su internet otterresti un login che risponde 200 e poi 401 a
# ogni richiesta, senza dire perche'.
BIND_ADDRESS=127.0.0.1

# Porta INTERNA al container. Con Docker non c'e' motivo di cambiarla: dentro al
# container non c'e' nient'altro che possa occuparla, e la porta che vedi da
# fuori e' APP_PORT. Se la cambi comunque, healthcheck e mappatura la seguono.
PORT=8000
HOST=0.0.0.0

SCHEDULER_ENABLED=true
